*.pyc
.coverage

# Learning/Research Feedback Context Memory repository data -- regenerable by re-running
# learning_feedback_capture_activation_run.py (or a future full-window equivalent) with the same
# run_id/window/seed; not source, not committed (canary run alone is ~130MB across two directories).
learning_feedback_data/

# Live observation process state (Mandate 4/5, 2026-07-30): the SQLite state store (bar-feed watermark,
# signal journal, structural observation journal) and stdout/stderr logs for the unattended
# ai_trader.live_observation process. Runtime data, not source; regenerated by the process itself.
live_observation_state/

# PDH-PDL DEMO live activation state (2026-08-04): SQLite state store (bar-feed watermark, signal/audit
# journal, dry-run + demo order ledgers/journals, portfolio P&L high-water-mark) and stdout/stderr logs
# for the unattended ai_trader.pdh_pdl_demo process. Runtime data, not source; regenerated by the process
# itself.
pdh_pdl_live_state/

# Multi-policy DEMO live activation state (2026-08-04): shared bar-feed watermark + signal journal, and
# per-policy state dirs (audit journal, dry-run/demo order ledgers, pnl-source db) for CAND-0007/CAND-
# 0009/CAND-0019, plus stdout/stderr logs for the unattended ai_trader.multi_policy_live process. Runtime
# data, not source; regenerated by the process itself.
multi_policy_live_state/

# Spread collection process state (2026-08-04): SQLite state store (bar-feed watermark, spread/session/
# ATR/level-touch observation journal) and stdout/stderr logs for the unattended
# ai_trader.spread_collection process. Runtime data, not source; regenerated by the process itself.
spread_collection_state/

# Zone observer process state (2026-08-04): SQLite state store (bar-feed watermark, session-level/
# demand-zone/IFVG/BPR/weekly-level/liquidity-void observation journal) and stdout/stderr logs for the
# unattended ai_trader.zone_observer process. Runtime data, not source; regenerated by the process itself.
zone_observer_state/

# Scratch full-tree pytest validation logs -- disposable, never source.
full_tree_run_*.log

# LIVE_SHADOW new_brain_live process state (CEO authorization 2026-08-17, RT-MANDATE2-0003): the SQLite
# state store (decision-authority flag, bar-feed watermark, telemetry log, shadow journal) and
