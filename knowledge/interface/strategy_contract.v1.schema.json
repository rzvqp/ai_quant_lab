{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-quant-lab/interface/strategy_contract.v1.schema.json",
  "title": "Strategy Execution Contract v1",
  "description": "Static, versioned, machine-readable contract every strategy in knowledge/strategies/ must expose as strategy.json. The AI Trader reads ONLY this contract plus the runtime API. Spec: STRATEGY_INTERFACE_v1.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["interface_version", "identity", "lifecycle", "semantics", "execution", "evidence", "provenance"],
  "properties": {
    "interface_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "const": "1.0.0" },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "slug", "version", "class"],
      "properties": {
        "id": { "type": "string", "pattern": "^S\\d+$" },
        "name": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^S\\d{2}_[a-z0-9_]+$" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "class": { "type": "string", "minLength": 1 }
      }
    },
    "lifecycle": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "maturity", "current_health", "last_review"],
      "properties": {
        "status": { "$ref": "#/$defs/StrategyStatus" },
        "maturity": { "$ref": "#/$defs/Maturity" },
        "current_health": { "$ref": "#/$defs/Health" },
        "priority": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "last_review": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "semantics": {
      "type": "object", "additionalProperties": false,
      "required": ["mechanism", "signal_reason", "market_regime", "required_data", "required_confirmations"],
      "properties": {
        "mechanism": { "type": "string", "minLength": 1 },
        "signal_reason": { "type": "string", "minLength": 1, "description": "Human template; runtime placeholders filled by explain_signal()." },
        "market_regime": {
          "type": "object", "additionalProperties": false, "required": ["applicable", "avoid"],
          "properties": {
            "applicable": { "type": "array", "items": { "$ref": "#/$defs/Regime" } },
            "avoid": { "type": "array", "items": { "$ref": "#/$defs/Regime" } }
          }
        },
        "required_data": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["timeframe", "fields", "lookback_bars"],
            "properties": {
              "timeframe": { "type": "string" },
              "fields": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
              "lookback_bars": { "type": "integer", "minimum": 0 },
              "htf": { "type": ["array", "null"], "items": { "type": "string" } }
            }
          }
        },
        "required_confirmations": { "type": "array", "items": { "type": "string" } },
        "dependencies": { "type": ["array", "null"], "items": { "type": "string", "pattern": "^S\\d+$" } }
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["timeframe", "sessions", "long_short", "entry", "exit", "stop", "risk_model",
                   "position_sizing", "max_concurrent_positions", "expected_frequency", "cooldown", "invalid_conditions"],
      "properties": {
        "timeframe": { "type": "string" },
        "sessions": { "type": "string" },
        "long_short": { "type": "string", "enum": ["LONG", "SHORT", "BOTH"] },
        "entry": { "$ref": "#/$defs/RuleSpec" },
        "exit": { "$ref": "#/$defs/RuleSpec" },
        "stop": { "$ref": "#/$defs/RuleSpec" },
        "target": { "oneOf": [ { "$ref": "#/$defs/RuleSpec" }, { "type": "null" } ] },
        "risk_model": {
          "type": "object", "additionalProperties": false, "required": ["model", "risk_definition", "stop_floor", "costs"],
          "properties": {
            "model": { "type": "string" },
            "risk_definition": { "type": "string" },
            "stop_floor": { "type": "string" },
            "costs": { "type": "string" }
          }
        },
        "position_sizing": { "type": "object" },
        "capital_limit": {
          "oneOf": [
            { "type": "null" },
            { "type": "object", "additionalProperties": false,
              "properties": {
                "max_risk_per_trade_R": { "type": ["number", "null"], "minimum": 0 },
                "max_strategy_allocation_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
              } }
          ]
        },
        "max_concurrent_positions": { "type": "integer", "minimum": 1 },
        "expected_frequency": {
          "type": "object", "additionalProperties": false, "required": ["trades_per_year", "basis"],
          "properties": {
            "trades_per_year": { "type": ["number", "null"], "minimum": 0 },
            "basis": { "type": "string" }
          }
        },
        "cooldown": {
          "type": "object", "additionalProperties": false, "required": ["bars", "scope"],
          "properties": {
            "bars": { "type": "integer", "minimum": 0 },
            "scope": { "type": "string", "enum": ["PER_STRATEGY", "PER_DIRECTION"] }
          }
        },
        "invalid_conditions": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["confidence", "historical_metrics", "oos_metrics", "walk_forward_status",
                   "matched_null_status", "global_fdr_status", "validation_status", "known_limitations"],
      "properties": {
        "confidence": {
          "type": "object", "additionalProperties": false, "required": ["level", "rationale"],
          "properties": {
            "level": { "$ref": "#/$defs/Confidence" },
            "score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "rationale": { "type": "string" }
          }
        },
        "historical_metrics": { "$ref": "#/$defs/Metrics" },
        "oos_metrics": { "$ref": "#/$defs/Metrics" },
        "walk_forward_status": { "$ref": "#/$defs/TestStatus" },
        "matched_null_status": {
          "type": "object", "additionalProperties": false, "required": ["status", "scope", "note"],
          "properties": {
            "status": { "$ref": "#/$defs/TestStatus" },
            "scope": { "type": "string", "enum": ["NONE", "PILOT", "WAVE1", "FULL_UNIVERSE"] },
            "p": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "adjusted_p": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "note": { "type": "string" }
          }
        },
        "global_fdr_status": { "$ref": "#/$defs/TestStatus" },
        "validation_status": { "type": "string", "minLength": 1 },
        "known_limitations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["engine", "generated_from", "holdout_status"],
      "properties": {
        "engine": { "type": "string" },
        "generated_from": { "type": "string" },
        "holdout_status": { "type": "string", "enum": ["SEALED", "OPENED"] },
        "source_ref": { "type": ["string", "null"], "description": "Opaque audit pointer. The AI Trader MUST NOT dereference it." }
      }
    }
  },
  "$defs": {
    "StrategyStatus": { "type": "string", "enum": ["IMPLEMENTED", "INVALID", "NOT_IMPLEMENTED", "DEPRECATED", "DISABLED"] },
    "Maturity": { "type": "string", "enum": ["EXPLORATORY", "CANDIDATE", "VALIDATED", "PROMOTED", "RETIRED"] },
    "Health": { "type": "string", "enum": ["OK", "DEGRADED", "STALE", "DISABLED", "INVALID", "UNKNOWN"] },
    "Confidence": { "type": "string", "enum": ["NONE", "NEGATIVE", "VERY_LOW", "LOW", "MEDIUM", "HIGH"] },
    "TestStatus": { "type": "string", "enum": ["NOT_RUN", "RUNNING", "PASS", "FAIL", "INCONCLUSIVE"] },
    "Regime": { "type": "string", "enum": ["TREND_UP", "TREND_DOWN", "RANGE", "HIGH_VOL", "LOW_VOL", "SESSION_OPEN", "ANY"] },
    "RuleSpec": {
      "type": "object", "additionalProperties": false, "required": ["description"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "trigger": { "type": ["string", "null"] },
        "timing": { "type": ["string", "null"] },
        "options": { "type": ["array", "null"], "items": { "type": "string" } }
      }
    },
    "Metrics": {
      "type": "object", "additionalProperties": false, "required": ["segment"],
      "properties": {
        "segment": { "type": "string" },
        "n": { "type": ["integer", "null"], "minimum": 0 },
        "expectancy_R": { "type": ["number", "null"] },
        "profit_factor": { "type": ["number", "null"], "minimum": 0 },
        "drawdown_R": { "type": ["number", "null"], "minimum": 0 },
        "win_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "pos_months": { "type": ["integer", "null"], "minimum": 0 },
        "months": { "type": ["integer", "null"], "minimum": 0 },
        "top1_share": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    }
  }
}
