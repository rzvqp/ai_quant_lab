<?xml version="1.0" encoding="UTF-8"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>LIVE_SHADOW persistent service (RT-N1-PERSIST-0001). Runs ai_trader.new_brain_live.entrypoint with the real venv interpreter, non-stop. BROKER_ORDER_SUBMISSION stays DISABLED -- this task never submits any order; it runs the shadow-only decision pipeline. Verified DISABLED before every start (entrypoint.py's own preflight, and the singleton/heartbeat/watchdog built alongside this task). See READY_FOR_N1_PERSIST_SERVICE.md for the full delivery record.</Description>
    <Author>AI Trader</Author>
    <URI>\AITraderLiveShadow</URI>
  </RegistrationInfo>
  <Triggers>
    <BootTrigger>
      <Enabled>true</Enabled>
    </BootTrigger>
    <LogonTrigger>
      <Enabled>true</Enabled>
      <UserId>DESKTOP-5H1K41D\MEDION GAMING</UserId>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>S-1-5-21-85522410-1122437461-2259342344-1001</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
